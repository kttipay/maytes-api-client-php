{
    "name": "maytes/api-client-php",
    "description": "Official PHP client for the Maytes API — create, capture and cancel checkouts, with OAuth2 token management and webhook signature verification.",
    "type": "library",
    "keywords": [
        "maytes",
        "checkout",
        "payments",
        "api",
        "sdk",
        "rest"
    ],
    "homepage": "https://developers.maytes.co",
    "license": "MIT",
    "authors": [
        {
            "name": "Maytes",
            "homepage": "https://developers.maytes.co"
        }
    ],
    "support": {
        "issues": "https://github.com/kttipay/maytes-api-client-php/issues",
        "source": "https://github.com/kttipay/maytes-api-client-php",
        "docs": "https://developers.maytes.co"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "MaytesApiClient\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MaytesApiClient\\Test\\": "test/"
        }
    }
}
